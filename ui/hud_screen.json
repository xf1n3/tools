{
  "namespace": "hud",

  "hud_content": {
    "type": "panel",
    "$hud_size": [ "100%", "100%" ],
    "$hud_player_rend_desktop_offset|default": [ 15, 15 ],

    "variables": [
      {
        "requires": "($is_holographic and not $is_living_room_mode)",
        "$hud_player_rend_desktop_offset": [ 100, 50 ]
      },
      {
        "requires": "($compress_hud_width)",
        "$hud_size": [ "90%", "100%" ]
      }
    ],

    "size": "$hud_size",

    "controls": [
      {
        "root_panel@hud.root_panel": {}
      },
      {
        "camera_renderer@camera_renderer": {}
      },
      {
        "hud_title_text@hud.hud_title_text": {}
      },
      {
        "hit_image@hud.hit_image": {}
      },
      {
        "hit1_image@hud.hit1_image": {}
      },
      {
        "hit2_image@hud.hit2_image": {}
      },
      {
        "hit3_image@hud.hit3_image": {}
      },
      {
        "air_image@hud.air_image": {}
      },
      {
        "hitmarker_image@hud.hitmarker_image": {}
      },
      {
        "headshot_image@hud.headshot_image": {}
      },
      {
        "hud_actionbar_text@hud.hud_actionbar_text": {}
      },
      {
        "hotbar_overlay@hud.hotbar_overlay": {}
      },

      // Фоновое изображение для полосок здоровья, голода, брони и actionbar
      {
        "survival_bars_bg": {
          "type": "image",
          "texture": "textures/ui/container1",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [ -29, 5 ],
          "size": [ 92, 150 ],
          "layer": 5,
          "alpha": 0.75,
          "bindings": [
            {
              "binding_name": "#show_survival_ui",
              "binding_name_override": "#visible"
            }
          ]
        }
      },

      // Новые кастомные рендереры в правом нижнем углу
      {
        "custom_health@heart_renderer": {
          "type": "custom",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [ -110, -90 ],
          "layer": 6,
          "bindings": [
            {
              "binding_name": "#show_survival_ui",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "custom_hunger@hunger_renderer": {
          "type": "custom",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [ -30, -80 ],
          "layer": 6,
          "bindings": [
            {
              "binding_name": "#show_survival_ui",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "custom_armor@armor_renderer": {
          "type": "custom",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [ -25, -35 ],
          "layer": 6,
          "bindings": [
            {
              "binding_name": "#is_armor_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  // ────────────────────────────────────────────────
  //   Убираем ванильные бары здоровья/голода/брони
  // ────────────────────────────────────────────────

  "centered_gui_elements_at_bottom_middle": {
    "type": "panel",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": [ 180, 50 ],
    "controls": [
      {
        "horse_heart_rend_0@horse_heart_renderer": {
          "offset": [ 180, -56 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#creative_horse_hearts",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "horse_heart_rend_1@horse_heart_renderer": {
          "offset": [ 180, -50 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#survival_horse_hearts",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "bubbles_rend_0@bubbles_renderer": {
          "offset": [ 180, -50 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#is_not_riding_bubbles",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "bubbles_rend_1@bubbles_renderer": {
          "offset": [ 180, -50 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#is_riding_bubbles",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      { "exp_rend@exp_progress_bar_and_hotbar": {} }
    ],
    "bindings": [
      {
        "binding_name": "#hud_visible_centered",
        "binding_name_override": "#visible",
        "binding_type": "global"
      }
    ]
  },

  "centered_gui_elements_at_bottom_middle_touch": {
    "type": "panel",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": [ 200, 50 ],
    "controls": [
      {
        "horse_heart_rend_0@horse_heart_renderer": {
          "offset": [ 200, -56 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#creative_horse_hearts",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "horse_heart_rend_1@horse_heart_renderer": {
          "offset": [ 200, -50 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#survival_horse_hearts",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "bubbles_rend_0@bubbles_renderer": {
          "offset": [ 200, -50 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#is_not_riding_bubbles",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "bubbles_rend_1@bubbles_renderer": {
          "offset": [ 200, -50 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "bindings": [
            {
              "binding_name": "#is_riding_bubbles",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      { "exp_rend@exp_progress_bar_and_hotbar": {} }
    ],
    "bindings": [
      {
        "binding_name": "#hud_visible_centered_touch",
        "binding_name_override": "#visible",
        "binding_type": "global"
      }
    ]
  },

  "not_centered_gui_elements": {
    "type": "panel",
    "controls": [
      {
        "hud_player_rend_pocket@hud_player_renderer": {
          "offset": [ 15, 25 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      },
      {
        "bubbles_rend_0@bubbles_renderer": {
          "offset": [ -2, 12 ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "bindings": [
            {
              "binding_name": "#is_not_riding_bubbles",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "bubbles_rend_1@bubbles_renderer": {
          "offset": [ -2, 12 ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "bindings": [
            {
              "binding_name": "#is_riding_bubbles",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#hud_visible_not_centered",
        "binding_name_override": "#visible",
        "binding_type": "global"
      }
    ]
  },

  // ────────────────────────────────────────────────
  //   HIT изображения (оригинал + 3 новых варианта)
  //   Эксклюзивны между собой (используют title)
  // ────────────────────────────────────────────────

  "hit_image": {
    "type": "image",
    "texture": "textures/ui/hit",
    "size": ["100%", "100%"],
    "layer": 11,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_title_text_string = 'HIT')",
        "target_property_name": "#visible"
      }
    ]
  },

  "hit1_image": {
    "type": "image",
    "texture": "textures/ui/hit1",
    "size": ["100%", "100%"],
    "layer": 11,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_title_text_string = 'HIT1')",
        "target_property_name": "#visible"
      }
    ]
  },

  "hit2_image": {
    "type": "image",
    "texture": "textures/ui/hit2",
    "size": ["100%", "100%"],
    "layer": 11,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_title_text_string = 'HIT2')",
        "target_property_name": "#visible"
      }
    ]
  },

  "hit3_image": {
    "type": "image",
    "texture": "textures/ui/hit3",
    "size": ["100%", "100%"],
    "layer": 11,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_title_text_string = 'HIT3')",
        "target_property_name": "#visible"
      }
    ]
  },

  "air_image": {
    "type": "image",
    "texture": "textures/ui/empty_air",
    "size": ["100%", "100%"],
    "layer": 11,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_title_text_string = 'AIR')",
        "target_property_name": "#visible"
      }
    ]
  },

  // ────────────────────────────────────────────────
  //   HITMARKER — отдельный канал (actionbar),
  //   отображается НЕЗАВИСИМО и ПОВЕРХ HIT/HIT1/HIT2/HIT3/AIR.
  //   Эксклюзивен сам по себе: видим только когда
  //   #hud_actionbar_text_string == 'HITMARKER'
  // ────────────────────────────────────────────────

  "hitmarker_image": {
    "type": "image",
    "texture": "textures/ui/hitmarker",
    "size": [ 24, 24 ],
    "offset": [ 0, 6.8 ],
    "layer": 12,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_title_text_string = 'HITMARKER')",
        "target_property_name": "#visible"
      }
    ]
  },

  "headshot_image": {
    "type": "image",
    "texture": "textures/ui/headshot",
    "size": [ 24, 24 ],
    "offset": [ 0, 6.8 ],
    "layer": 12,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_title_text_string = 'HEADSHOTMARKER')",
        "target_property_name": "#visible"
      }
    ]
  },

  "hud_title_text": {
    "type": "panel",
    "size": [ "100%c", "100%c" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": [ 0, 10 ],
    "alpha": "@hud.anim_title_text_alpha_out",

    "controls": [
      {
        "title": {
          "type": "label",
          "text": "$title_text",
          "anchor_from": "center",
          "anchor_to": "center",
          "text_alignment": "center",
          "color": "$tool_tip_text",
          "layer": 1,
          "localize": false,
          "font_size": "small",
          "font_scale_factor": 1.65,
          "alpha": "@hud.anim_title_text_alpha_out",
          "bindings": [
            {
              "binding_name": "#hud_title_text_string"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#hud_title_text_string = 'HIT') and not (#hud_title_text_string = 'HIT1') and not (#hud_title_text_string = 'HIT2') and not (#hud_title_text_string = 'HIT3') and not (#hud_title_text_string = 'AIR') and not (#hud_title_text_string = 'HITMARKER') and not (#hud_title_text_string = 'HEADSHOTMARKER'))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  "hud_actionbar_text": {
    "type": "image",
    "texture": "textures/ui/empty_air",
    "size": [ "110%c + 12px", "110%c + 5px" ],
    "offset": [ "35%", "-21%" ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "alpha": "@hud.anim_actionbar_bg_alpha_out",
    "layer": 8,
    "controls": [
      {
        "actionbar_message": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "text": "$actionbar_text",
          "color": "$tool_tip_text",
          "shadow": true,
          "layer": 31,
          "localize": false,
          "alpha": "@hud.anim_actionbar_text_alpha_out"
        }
      }
    ]
  },

  "hotbar_overlay": {
    "type": "image",
    "texture": "textures/ui/hotbar",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": [ "100%", "50px" ],
    "offset": [ 0, "15px" ],
    "layer": 3,
    "alpha": 1.0
  },

  // Анимации (без изменений)
  "anim_title_text_alpha_out": {
    "anim_type": "alpha",
    "easing": "in_expo",
    "duration": 1,
    "from": 1.0,
    "to": 0,
    "destroy_at_end": "hud_title_text"
  },

  "anim_actionbar_text_alpha_out": {
    "anim_type": "alpha",
    "easing": "in_quart",
    "duration": 0.35,
    "from": 1.0,
    "to": 0.0
  },

  "anim_actionbar_bg_alpha_out": {
    "anim_type": "alpha",
    "easing": "in_quart",
    "duration": 0.4,
    "from": 0.55,
    "to": 0.0,
    "destroy_at_end": "hud_actionbar_text"
  },

  "anim_actionbar_text_alpha_in": {
    "anim_type": "alpha",
    "easing": "out_quart",
    "duration": 0.2,
    "from": 0.0,
    "to": 1.0
  },

  "anim_actionbar_bg_alpha_in": {
    "anim_type": "alpha",
    "easing": "out_quart",
    "duration": 0.25,
    "from": 0.0,
    "to": 0.55
  }
}
